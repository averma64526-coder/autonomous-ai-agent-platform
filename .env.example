# ─── App ───
APP_NAME=Autonomous AI Agent Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ─── Database (PostgreSQL) ───
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=aiagent_pass
POSTGRES_DB=aiagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── LLM API ───
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# ─── JWT Auth ───
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
